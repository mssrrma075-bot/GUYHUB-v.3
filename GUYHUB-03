local function removeESP(player)
    if ESPStorage[player] then
        if ESPStorage[player].Billboard then ESPStorage[player].Billboard:Destroy() end
        if ESPStorage[player].Highlight then ESPStorage[player].Highlight:Destroy() end
        ESPStorage[player] = nil
    end
end

local function updateESPState(player)
    if player == LocalPlayer or not player.Character then 
        removeESP(player)
        return 
    end
    local char = player.Character
    local head = char:FindFirstChild("Head")
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if not head or not humanoid or humanoid.Health <= 0 then
        removeESP(player)
        return
    end

    if not ESPStorage[player] then ESPStorage[player] = {} end

    if nameEspEnabled or healthEspEnabled then
        if not ESPStorage[player].Billboard then
            local bb = Instance.new("BillboardGui")
            bb.Name = "GUYHUB_ESP"
            bb.Size = UDim2.new(0, 100, 0, 50)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true
            bb.Parent = head

            local label = Instance.new("TextLabel")
            label.Name = "TextInfo"
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextStrokeTransparency = 0
            label.TextSize = 14
            label.Font = Enum.Font.SourceSansBold
            label.Parent = bb

            ESPStorage[player].Billboard = bb
            ESPStorage[player].TextLabel = label
        end

        local textResult = ""
        if nameEspEnabled then textResult = player.Name .. "\n" end
        if healthEspEnabled then textResult = textResult .. "HP: " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth) end
        ESPStorage[player].TextLabel.Text = textResult
        ESPStorage[player].Billboard.Enabled = true
    else
        if ESPStorage[player].Billboard then ESPStorage[player].Billboard.Enabled = false end
    end

    if highlightEspEnabled then
        if not ESPStorage[player].Highlight then
            local hl = Instance.new("Highlight")
            hl.Name = "GUYHUB_Highlight"
            hl.Adornee = char
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.Parent = char
            ESPStorage[player].Highlight = hl
        else
            ESPStorage[player].Highlight.Enabled = true
        end
    else
        if ESPStorage[player].Highlight then ESPStorage[player].Highlight.Enabled = false end
    end
end

